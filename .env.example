# Python Debug Dojo — deploy configuration
# Copy this file to `.env` and fill in the values, then run `bash deploy.sh`.
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.

# ─── Required ────────────────────────────────────────────────────────────────

# GitHub owner (user or org) that will host the three repos.
GITHUB_USER=

# Anthropic API key used by the proxy Edge Function. SENSITIVE.
# Get one at https://console.anthropic.com/ . Never share or commit this.
ANTHROPIC_API_KEY=

# ─── Optional (leave blank for automatic behaviour) ──────────────────────────

# Restrict the proxy to a single browser origin (CORS allow-list).
# Leave blank and the deploy sets this to the app's deployed URL automatically
# (see scripts/30-vercel-env.sh). Set explicitly to lock it down, e.g.
# https://pydojo-app.vercel.app
ALLOWED_ORIGIN=

# Vercel team/scope slug, passed to `vercel --scope`. Blank = personal account.
# Setting this avoids interactive team-selection prompts.
VERCEL_SCOPE=

# Repo/folder names for the three projects. These are used as BOTH the sub-folder
# name AND the GitHub/Vercel project name, so only change them if you also rename
# the folders on disk. Blank = the defaults shown.
LANDING_REPO_NAME=pydojo-landing
APP_REPO_NAME=pydojo-app
PROXY_REPO_NAME=pydojo-proxy

# Advanced (not set by the deploy scripts): the proxy reads ANTHROPIC_MODEL from
# its Vercel env if present, otherwise falls back to a current default baked into
# pydojo-proxy/api/ai.js. Set it in the Vercel dashboard to pin a model.
